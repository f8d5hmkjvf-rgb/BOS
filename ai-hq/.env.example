# Copiez ce fichier en .env.local (jamais commité) et complétez.

# --- Obligatoire pour l'orchestrateur ---
DATABASE_URL=postgres://user:motdepasse@localhost:5432/aihq
ANTHROPIC_API_KEY=

# --- Modèles : économique par défaut, avancé pour Gaspard et les tâches complexes ---
# AIHQ_MODEL_ECONOMY=claude-sonnet-5-5
# AIHQ_MODEL_ADVANCED=claude-opus-5-5
# AIHQ_EFFORT_CEO=high        # low | medium | high | xhigh | max
# AIHQ_EFFORT_AGENT=medium
# AIHQ_EFFORT_COMPLEX=high
# AIHQ_EFFORT_DIALOGUE=low

# --- Contrôle des coûts (USD) ---
AIHQ_MISSION_BUDGET_USD=3
AIHQ_MAX_MISSION_BUDGET_USD=3
AIHQ_DAILY_BUDGET_USD=20
# AIHQ_MAX_TOOL_ITERATIONS=10
# AIHQ_MAX_TASKS=8

# --- Worker ---
# AIHQ_WORKER_CONCURRENCY=3
# AIHQ_LEASE_SECONDS=300

# --- Authentification (OBLIGATOIRE en ligne) ---
AIHQ_ADMIN_PASSWORD=          # 12 caractères minimum
AIHQ_SESSION_SECRET=          # 32+ caractères aléatoires : openssl rand -base64 48
# AIHQ_ADMIN_TOKEN=           # jeton d'API (24+ caractères) pour n8n / scripts : Authorization: Bearer …

# --- Déploiement docker compose ---
# DOMAIN=hq.mondomaine.fr
# POSTGRES_PASSWORD=

# --- Intégrations (chaque action d'un agent exige ta validation) ---
# AIHQ_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# AIHQ_N8N_WEBHOOK_URL=https://n8n.mondomaine.fr/webhook/ai-hq
# AIHQ_N8N_SECRET=            # envoyé dans l'en-tête x-aihq-secret, à vérifier côté n8n
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=moi@mondomaine.fr
# GMAIL_MODE=draft            # draft (brouillons, par défaut) | send
# GMAIL_ALLOWED_DOMAINS=      # ex. client1.fr,client2.com (vide = tous)
# AIHQ_WEBHOOK_URL=           # webhook générique (Make, Zapier…)
# AIHQ_NOTIFY_WEBHOOK_URL=    # notification de fin de mission
# AIHQ_WEB_SEARCH=1          # 0 pour désactiver la recherche web des agents
