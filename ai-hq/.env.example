# AI HQ — copiez en .env (Docker) ou .env.local (npm run dev). Ne commitez jamais ce fichier.

# --- Indispensable ---
POSTGRES_PASSWORD=                 # mot de passe de la base Docker (inventez-le)
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
AIHQ_ADMIN_PASSWORD=               # votre mot de passe de connexion à AI HQ (12 caractères minimum)
AIHQ_SESSION_SECRET=               # openssl rand -base64 48
AIHQ_ENCRYPTION_KEY=               # openssl rand -base64 32  (chiffre les jetons Google, secrets n8n/Slack)

# --- Adresse publique (OAuth Google, accès téléphone) ---
# AIHQ_PUBLIC_URL=https://mon-pc.mon-reseau.ts.net   # adresse Tailscale ou domaine ; vide = http://localhost:3000
# AIHQ_INSECURE_COOKIE=1          # UNIQUEMENT pour un usage en http://localhost sans HTTPS (Safari)

# --- Budgets (USD) ---
AIHQ_MISSION_BUDGET_USD=3
AIHQ_MAX_MISSION_BUDGET_USD=3
AIHQ_DAILY_BUDGET_USD=20

# --- Modèles : économique par défaut, avancé pour Gaspard et les tâches complexes ---
# AIHQ_MODEL_ECONOMY=claude-sonnet-5-5
# AIHQ_MODEL_ADVANCED=claude-opus-5-5
# AIHQ_EFFORT_CEO=high
# AIHQ_EFFORT_AGENT=medium
# AIHQ_EFFORT_COMPLEX=high
# AIHQ_EFFORT_DIALOGUE=low

# --- Divers ---
# AIHQ_ADMIN_TOKEN=               # jeton d'API (24+ caractères) pour piloter AI HQ depuis n8n : Authorization: Bearer …
# AIHQ_WORKER_CONCURRENCY=3
# AIHQ_WEB_SEARCH=1
# AIHQ_WEBHOOK_URL=               # webhook générique (Make, Zapier…) ; n8n, Google et Slack se règlent dans Paramètres
# AIHQ_NOTIFY_WEBHOOK_URL=
# DOMAIN=hq.mondomaine.fr          # uniquement avec --profile public (serveur + domaine)
