# Copiez ce fichier en .env.local (jamais commité) et complétez.

# --- Obligatoire pour l'orchestrateur ---
DATABASE_URL=postgres://user:motdepasse@localhost:5432/aihq
ANTHROPIC_API_KEY=

# --- Modèles (par défaut : claude-opus-5-5 partout) ---
# AIHQ_MODEL_CEO=claude-opus-5-5
# AIHQ_MODEL_AGENT=claude-opus-5-5
# AIHQ_MODEL_DIALOGUE=claude-opus-5-5
# AIHQ_EFFORT_CEO=high        # low | medium | high | xhigh | max
# AIHQ_EFFORT_AGENT=medium
# AIHQ_EFFORT_DIALOGUE=low

# --- Contrôle des coûts (USD) ---
# AIHQ_MISSION_BUDGET_USD=3
# AIHQ_DAILY_BUDGET_USD=20
# AIHQ_MAX_TOOL_ITERATIONS=10
# AIHQ_MAX_TASKS=8

# --- Worker ---
# AIHQ_WORKER_CONCURRENCY=3
# AIHQ_LEASE_SECONDS=300

# --- Sécurité : exige un jeton pour toute action qui dépense ou agit ---
# AIHQ_ADMIN_TOKEN=

# --- Intégrations externes ---
# AIHQ_WEBHOOK_URL=          # Slack/Make/Zapier/n8n : chaque envoi par un agent exige ta validation
# AIHQ_NOTIFY_WEBHOOK_URL=   # notification de fin de mission
# AIHQ_WEB_SEARCH=1          # 0 pour désactiver la recherche web des agents
